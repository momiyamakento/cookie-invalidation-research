# Phase 1 server ports
MANAGEMENT_SERVER_PORT=4100
# Optional. Defaults to apps/management-server/data/management.sqlite.
# MANAGEMENT_DB_PATH=C:\absolute\path\to\management.sqlite
SITE_A_PORT=3101
SITE_B_PORT=3102
SITE_C_PORT=3103
SITE_D_PORT=3104

# Phase 6 startup mapping registration (non-secret experiment identifiers).
MANAGEMENT_BASE_URL=http://localhost:4100
SITE_A_PRINCIPAL_ID=principal-001
SITE_B_PRINCIPAL_ID=principal-001
SITE_C_PRINCIPAL_ID=principal-001
SITE_D_PRINCIPAL_ID=principal-001

# Required when Site B/C initialize their experiment users.
SITE_B_SEED_PASSWORD=
SITE_C_SEED_PASSWORD=
SITE_D_SEED_PASSWORD=
# SITE_B_DB_PATH=C:\absolute\path\to\site-b.sqlite
# SITE_C_DB_PATH=C:\absolute\path\to\site-c.sqlite

# Required when Site A initializes its experiment user.
# Set this to a local research password of at least 12 characters.
SITE_A_SEED_PASSWORD=
# Optional. Defaults to apps/site-a/data/site-a.sqlite.
# SITE_A_DB_PATH=C:\absolute\path\to\site-a.sqlite

# Required by Phase 7 detection notification. Values must be unique.
SITE_A_TO_MANAGER_TOKEN=change-me-site-a
SITE_B_TO_MANAGER_TOKEN=change-me-site-b
SITE_C_TO_MANAGER_TOKEN=change-me-site-c
SITE_D_TO_MANAGER_TOKEN=change-me-site-d

# Required by each Site's Phase 8 internal revocation API. Values must be unique.
MANAGER_TO_SITE_A_TOKEN=change-me-manager-to-site-a
MANAGER_TO_SITE_B_TOKEN=change-me-manager-to-site-b
MANAGER_TO_SITE_C_TOKEN=change-me-manager-to-site-c
MANAGER_TO_SITE_D_TOKEN=change-me-manager-to-site-d

# Limit newly accepted detection event IDs per service. Identical eventId
# retries do not consume additional capacity.
DETECTION_RATE_LIMIT_MAX_EVENTS=10
DETECTION_RATE_LIMIT_WINDOW_MS=60000

# Optional Phase 13 evaluation secret. Management derives per-benchmark-service
# tokens with HMAC-SHA-256(secret, "cookie-research:" + serviceId).
# BENCHMARK_SHARED_SECRET=

# Optional local presentation dashboard (npm run start:demo:all).
# DEMO_PORT=4200
# DEMO_ATTACKER_PORT=4201
